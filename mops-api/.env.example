# Mops-API Konfiguration
# Kopiere diese Datei nach `.env` und passe die Werte bei Bedarf an.

# HTTP-Server
API_HOST=0.0.0.0
API_PORT=8080

# Ollama-Backend (laeuft auf demselben Mops-Server)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=180

# CORS — nur LAN (192.168.x.x, 10.x.x.x, 172.16-31.x.x) + localhost.
# Wichtig fuer den HTML-Grid-Viewer im Browser; iOS-Apps ignorieren CORS sowieso.
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$

# Logging-Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
