		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- ATS-Ausnahme: Mops-Server laeuft auf HTTP im LAN (kein TLS) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.2.42</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Spracherkennung: lokal auf Gerät, keine Cloud-Übertragung -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>iMOPS nutzt die Spracherkennung lokal auf deinem Gerät für Baustellenberichte und Mängelerfassung. Es werden keine Sprachdaten an externe Server übertragen.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Das Mikrofon wird für die Spracheingabe bei Berichten und Mängelerfassung benötigt. Die Verarbeitung erfolgt lokal auf deinem Gerät.</string>
</dict>
